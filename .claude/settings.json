{
  "permissions": {
    "deny": [
      "Edit(**/.claude/hooks/license-policy.json)",
      "Write(**/.claude/hooks/license-policy.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-helm-licences.py",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
