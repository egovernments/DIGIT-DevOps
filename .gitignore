**/*/service_images.json
**/*.pyc

# OSX leaves these everywhere on SMB shares
._*

# OSX trash
.DS_Store

# Files generated by JetBrains IDEs, e.g. IntelliJ IDEA
.idea/
*.iml

# Vscode files
.vscode

# Emacs save files
*~
\#*\#
.\#*

# Vim-related files
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Chart dependencies
**/charts/*.tgz
*Chart.lock

.history

# Terraform. .terraform/ and *.tfstate were already covered; the rest are the
# gaps. Plan files and tfvars are the sensitive ones -- a saved plan embeds
# resource attribute values (storage account keys, connection strings) in
# plaintext, exactly as state does.
*.terraform
*.tfstate
*.tfstate.*
tfplan
*.tfplan
*.tfvars
*.tfvars.json
# NOT ignored, deliberately: .terraform.lock.hcl is committed alongside the
# module it pins.
