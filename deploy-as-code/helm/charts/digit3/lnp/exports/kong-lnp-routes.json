            "jwt"
          ],
          "header_names": [
            "authorization"
          ],
          "cache_ttl": 3600
        }
      },
      {
        "name": "metadata-enrichment",
        "config": {
          "canonical_path_segments": [
            "/v3/canonical/"
          ],
          "enrich_tenant_id": true,
          "enrich_user_info": true,
          "max_body_bytes": 1048576,
          "metadata_keys": [
            "RequestMetadata",
            "requestMetadata"
          ],
          "enrich_tracing_ids": true,
          "enrich_timestamp": true
        }
      },
      {
        "name": "token-revocation",
        "config": {
          "redis_timeout": 1000,
          "redis_database": 0,
          "terminate_on_logout": true,
          "revocation_ttl": 50400,
          "redis_host": "redis.backbone.svc.cluster.local",
          "redis_password": null,
          "enable_plugin": true,
          "logout_path_segment": "logout",
          "fail_open": false,
          "redis_port": 6379
        }
      },
      {
        "name": "keycloak-rbac",
        "config": {
          "keycloak_base_url": "http://keycloak.keycloak.svc.cluster.local:8080/keycloak",
          "client_id": "auth-server",
          "max_cache_entries": 10000,
          "enable_plugin": true,
          "collapse_uuid_in_cache_key": true,
          "cache_ttl": 300,
          "timeout": 5000
        }
      },
      {
        "name": "header-enrichment",
        "config": {
          "tenant_header_sources": [
            "X-JWT-tenant",
            "X-JWT-organization",
            "X-Tenant-ID"
          ],
          "enable_jwt_headers": true,
          "default_tenant": "default",
