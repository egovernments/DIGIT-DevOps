[
  {
    "name": "license-certificate-route",
    "paths": [
      "/license"
    ],
    "methods": null,
    "strip_path": false,
    "preserve_host": false,
    "service": {
      "name": "license-certificate",
      "host": "license-certificate.egov.svc.cluster.local",
      "port": 8080,
      "path": null,
      "plugins": []
    },
    "plugins": [
      {
        "name": "dynamic-jwt",
        "config": {
          "keycloak_base_url": "http://keycloak.keycloak.svc.cluster.local:8080/keycloak",
          "claims_to_verify": [
            "exp"
          ],
          "uri_param_names": [
            "jwt"
          ],
          "header_names": [
            "authorization"
          ],
          "cache_ttl": 3600
        }
      },
      {
        "name": "header-enrichment",
        "config": {
          "tenant_header_sources": [
            "X-JWT-tenant",
            "X-JWT-organization",
            "X-Tenant-ID"
          ],
          "enable_jwt_headers": true,
          "default_tenant": "default",
          "enable_api_headers": true
        }
      }
    ]
  },
