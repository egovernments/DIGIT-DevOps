{
  "_comment": "LnP Kong routes, exported from test-lts (phase 0). Replayed by digit3 src/services/kong/setup.py when KONG_EXTRA_ROUTES points here: services are upserted from `url`, routes get strip_path=false and the listed plugins (names from setup.py's PLUGIN_DEFINITIONS; [] = public route). Edit here, not in Kong.",
  "routes": [
    {
      "name": "calculator-route",
      "service": "calculator",
      "url": "http://calculator.egov.svc.cluster.local:8080",
      "paths": [
        "/calculator"
      ],
      "plugins": [
        "header-enrichment",
        "dynamic-jwt"
      ]
    },
    {
      "name": "calculator-rules-public-route",
      "service": "calculator",
      "url": "http://calculator.egov.svc.cluster.local:8080",
      "paths": [
        "~/calculator/calculation/v3/[^/]+/rules$"
      ],
      "methods": [
        "GET"
      ],
      "plugins": []
    },
    {
      "name": "license-certificate-route",
      "service": "license-certificate",
      "url": "http://license-certificate.egov.svc.cluster.local:8080",
      "paths": [
        "/license"
      ],
      "plugins": [
        "dynamic-jwt",
        "header-enrichment"
      ]
    },
    {
      "name": "license-certificate-types-public-route",
      "service": "license-certificate",
      "url": "http://license-certificate.egov.svc.cluster.local:8080",
      "paths": [
        "~/license/certificate-types$",
        "~/license/certificate-types/[^/]+$",
        "~/license/certificate-types/[^/]+/categories$"
      ],
      "methods": [
        "GET"
      ],
      "plugins": []
    },
    {
      "name": "mdms-route",
      "service": "mdms-v2",
      "url": "http://mdms-v2.egov.svc.cluster.local:8080",
      "paths": [
        "/mdms-v2"
      ],
      "plugins": [
        "dynamic-jwt",
        "metadata-enrichment",
        "token-revocation",
        "keycloak-rbac",
        "header-enrichment"
      ]
    },
    {
      "name": "pdf-template-public-route",
      "service": "pdf-v3",
      "url": "http://pdf-v3.egov.svc.cluster.local:8080",
      "paths": [
        "~/pdf-v3/[^/]+/template$"
      ],
      "methods": [
        "GET"
      ],
      "plugins": []
    },
    {
      "name": "pdf-v3-route",
      "service": "pdf-v3",
      "url": "http://pdf-v3.egov.svc.cluster.local:8080",
      "paths": [
        "/pdf-v3"
      ],
      "plugins": [
        "dynamic-jwt",
        "header-enrichment"
      ]
    },
    {
      "name": "schema-certificate-checklist-schema-public-route",
      "service": "schema-registry",
      "url": "http://schema-registry.egov.svc.cluster.local:8080",
      "paths": [
        "~/schema/certificate/[^/]+\\.checklist/schema$"
      ],
      "methods": [
        "GET"
      ],
      "plugins": []
    },
    {
      "name": "schema-certificate-form-config-public-route",
      "service": "schema-registry",
      "url": "http://schema-registry.egov.svc.cluster.local:8080",
      "paths": [
        "~/schema/certificate/[^/]+\\.form/config$"
      ],
      "methods": [
        "GET"
      ],
      "plugins": []
    },
    {
      "name": "schema-registry-route",
      "service": "schema-registry",
      "url": "http://schema-registry.egov.svc.cluster.local:8080",
      "paths": [
        "/schema"
      ],
      "plugins": [
        "dynamic-jwt",
        "header-enrichment"
      ]
    },
    {
      "name": "vc-credential-public-route",
      "service": "vc",
      "url": "http://vc.egov.svc.cluster.local:8080",
      "paths": [
        "~/credential/credential-types$",
        "~/credential/[A-Z][A-Z0-9_]*$"
      ],
      "methods": [
        "GET"
      ],
      "plugins": []
    },
    {
      "name": "vc-route",
      "service": "vc",
      "url": "http://vc.egov.svc.cluster.local:8080",
      "paths": [
        "/credential"
      ],
      "plugins": [
        "header-enrichment",
        "dynamic-jwt"
      ]
    }
  ]
}