# DIGIT one-click: deploys the layers in order. Inputs: DIGIT_ENV_FILE and DIGIT_SECRETS_FILE
# (deploy-as-code/helm/environments/<env>.yaml and <env>-secrets.yaml). Each layer can also
# run alone, e.g. helmfile -f helmfiles/core.yaml.gotmpl apply.
helmfiles:
  - path: helmfiles/backbone.yaml.gotmpl
  - path: helmfiles/core.yaml.gotmpl
  - path: helmfiles/monitoring.yaml.gotmpl
