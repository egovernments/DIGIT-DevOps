# DIGIT one-click: deploys the three layers in order. Each is also deployable on its own:
#   helmfile -f helmfiles/backbone.yaml.gotmpl   apply   # cluster-configs + backbone (+ Vault bootstrap)
#   helmfile -f helmfiles/core.yaml.gotmpl       apply   # Keycloak, Kong, DIGIT 3.0 core services
#   helmfile -f helmfiles/monitoring.yaml.gotmpl apply   # Prometheus, Grafana, Loki, OTel, Jaeger, blackbox
# Inputs (exported by the workflow): DIGIT_CONFIG, DIGIT_SECRETS, TF_OUTPUTS_FILE (absolute paths).
helmfiles:
  - path: helmfiles/backbone.yaml.gotmpl
  - path: helmfiles/core.yaml.gotmpl
  - path: helmfiles/monitoring.yaml.gotmpl
