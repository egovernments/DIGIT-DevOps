{{/* Every digit3 image tag comes from ONE deploy-time input:
     DIGIT_TAG=modulith-<sha> ./deploy.sh -f <shape-helmfile> sync
   The build pipeline stamps services, bundles and their -db init images with
   the same tag, so one variable pins them all. requiredEnv fails the deploy
   loudly when it is unset — never a half-deployed shape. */}}
{{ $tag := requiredEnv "DIGIT_TAG" }}

idgen:
  image:
    tag: "{{ $tag }}"
  initContainers:
    dbMigration:
      image:
        tag: "{{ $tag }}"

template-config:
  image:
    tag: "{{ $tag }}"
  initContainers:
    dbMigration:
      image:
        tag: "{{ $tag }}"

