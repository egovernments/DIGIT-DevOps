{{/* GENERATED by bundler/generate_bundle_chart.py from dev-bundle.package.yaml + environments/bundle-defaults.yaml — do not edit; re-run the generator. */}}
{{ $domain := requiredEnv "DOMAIN" }}
{{ $tag := requiredEnv "DIGIT_TAG" }}
"dev-bundle":
  "namespace": "egov"
  "image":
    "repository": "dev-bundle"
    "pullPolicy": "IfNotPresent"
    "tag": "{{ $tag }}"
  "env":
    "TENANT_MIGRATION_ENABLED":
      "value": "true"
    "KEYCLOAK_PUBLIC_BASE_URL":
      "value": "https://{{ $domain }}/keycloak"
    "URL_SHORTENER_HOST_NAME":
      "value": "https://{{ $domain }}"
    "VAULT_ENABLED":
      "value": "true"
    "S3_ACCESS_KEY":
      "valueFrom":
        "secretKeyRef":
          "name": "minio"
          "key": "accesskey"
    "S3_SECRET_KEY":
      "valueFrom":
        "secretKeyRef":
          "name": "minio"
          "key": "secretkey"
    "S3_ENDPOINT":
      "value": "minio.backbone.svc.cluster.local:9000"
    "S3_USE_SSL":
      "value": "false"
    "FILESTORE_S3_SOURCE":
      "value": "s3"
    "CLIENT_REDIRECT_URL":
      "value": "https://{{ $domain }}/*"
    "FIRST_LOGIN_URLS":
      "value": "admin=https://{{ $domain }}/license/admin/{realm},employee=https://{{ $domain }}/license/employee/{realm},citizen=https://{{ $domain }}/license/citizen/{realm}"
  "dbMigrationOrder":
  - "combined"
  "dbMigrations":
    "combined":
      "enabled": !!bool "true"
      "image":
        "repository": "dev-bundle-db"
        "pullPolicy": "IfNotPresent"
        "tag": "{{ $tag }}"
      "env":
        "DB_URL":
          "value": "jdbc:postgresql://postgresql-lts.egov:5432/postgres"
        "FLYWAY_USER":
          "valueFrom":
            "secretKeyRef":
              "name": "db"
              "key": "flyway-username"
        "FLYWAY_PASSWORD":
          "valueFrom":
            "secretKeyRef":
              "name": "db"
              "key": "flyway-password"
