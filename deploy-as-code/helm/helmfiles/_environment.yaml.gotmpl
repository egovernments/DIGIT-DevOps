# Shared base for backbone/core/monitoring helmfiles: layered values + chart repositories.
#   1. ../defaults.yaml                   platform defaults (namespaces, versions, sizing)
#   2. $DIGIT_CONFIG  (digit-config.yaml)  the team's ONE file (overrides anything)
#   3. $TF_OUTPUTS_FILE                   infra.* from Terraform (DB host/name, ...)
#   4. $DIGIT_SECRETS (digit-secrets.yaml) generated, SOPS/Azure Key Vault, decrypted by helm-secrets
environments:
  default:
    values:
      - ../defaults.yaml
      - {{ requiredEnv "DIGIT_CONFIG" }}
      - {{ requiredEnv "TF_OUTPUTS_FILE" }}
    secrets:
      - {{ requiredEnv "DIGIT_SECRETS" }}
---
# Chart repositories are declared in each layer helmfile (only the ones it uses), so
# rendering one layer - or one release in Argo CD mode - downloads only those indexes.
helmDefaults:
  createNamespace: true
  wait: true
  waitForJobs: true
  timeout: 900
