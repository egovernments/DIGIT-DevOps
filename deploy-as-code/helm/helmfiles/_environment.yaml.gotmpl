# Shared base of every layer helmfile. The ONLY inputs are the two environment files:
#   DIGIT_ENV_FILE      deploy-as-code/helm/environments/<env>.yaml          (plain YAML)
#   DIGIT_SECRETS_FILE  deploy-as-code/helm/environments/<env>-secrets.yaml  (SOPS, helm-secrets)
# Both are merged into .Values; each release gets its own block (block name = release name).
environments:
  default:
    values:
      - {{ requiredEnv "DIGIT_ENV_FILE" }}
    secrets:
      - {{ requiredEnv "DIGIT_SECRETS_FILE" }}
---
helmDefaults:
  createNamespace: true
  wait: true
  waitForJobs: true
  timeout: 900
