# Argo CD mode only (infra.argocd.enabled: true). The workflow installs Argo CD with this
# helmfile; Argo CD then deploys every DIGIT release from the fork through the plugin
# "digit-helmfile" (scripts/argocd-plugin.sh): same helmfiles, same environment files.
# UI: https://<domain>/argocd, user admin, password cluster-configs.secrets.argocd-admin
# (secrets file).
# sops in the plugin decrypts <env>-secrets.yaml with the AKS kubelet managed identity.
# Inputs from the workflow: ARGOCD_ADMIN_HASH (bcrypt), KUBELET_CLIENT_ID.
bases:
  - _environment.yaml.gotmpl
---
{{- /* Values of one release = its block in the env file (+ secrets file), without the keys
       only the helmfile uses. DIGIT common-based charts also get "global" and their namespace. */ -}}
{{- define "release-values" -}}
{{- $b := omit (.v | get .r dict) "chart-version" "enabled" -}}
{{- if hasKey . "common" }}{{ $b = merge (dict "global" (merge (dict "namespace" .ns) (.v | get "global" dict)) "namespace" .ns) $b }}{{ end -}}
{{- if hasKey . "wrap" }}{{ $b = dict .r $b }}{{ end -}}
{{- toYaml $b -}}
{{- end -}}
{{- define "chart-version" -}}
{{- required (printf "%s.chart-version is missing in the environment file" .r) (.v | get (printf "%s.chart-version" .r) "") -}}
{{- end -}}

{{- $v := .Values }}
repositories:
  - name: digit3-backbone
    url: https://helm.digit.org/digit3/backbone
releases:
  - name: argo-cd
    namespace: argocd
    chart: digit3-backbone/argo-cd
    version: {{ include "chart-version" (dict "v" $v "r" "argo-cd") }}
    labels: {layer: argocd}
    values:
      - global:
          domain: {{ $v.global.domain }}

        configs:
          params:
            server.insecure: true              # TLS ends at ingress-nginx
            server.basehref: /argocd
            server.rootpath: /argocd
            # helmfile renders a whole release; give the plugin time
            controller.repo.server.timeout.seconds: 600
            # Each render loads the chart-repo indexes (~150-300 MiB). 39 Applications rendering at
            # once OOM-kill the sidecar, so cap concurrent renders.
            reposerver.parallelism.limit: 3
          cm:
            url: https://{{ $v.global.domain }}/argocd
            timeout.reconciliation: 180s
            # Make the root app wait for each child Application's health (sync waves = layers).
            resource.customizations.health.argoproj.io_Application: |
              hs = {}
              hs.status = "Progressing"
              hs.message = ""
              if obj.status ~= nil and obj.status.health ~= nil then
                hs.status = obj.status.health.status
                if obj.status.health.message ~= nil then hs.message = obj.status.health.message end
              end
              return hs
          secret:
            argocdServerAdminPassword: {{ requiredEnv "ARGOCD_ADMIN_HASH" | quote }}
          cmp:
            create: true
            plugins:
              digit-helmfile:
                generate:
                  command: [bash, scripts/argocd-plugin.sh]

        server:
          ingress:
            enabled: true
            ingressClassName: nginx
            hostname: {{ $v.global.domain }}
            path: /argocd
            pathType: Prefix
            annotations:
              cert-manager.io/cluster-issuer: letsencrypt-prod
            tls: false
            extraTls:
              - hosts: [{{ $v.global.domain }}]
                secretName: {{ $v.global.domain }}-tls-certs

        repoServer:
          env:
            - name: ARGOCD_EXEC_TIMEOUT
              value: 10m
          volumes:
            - name: cmp-tmp
              emptyDir: {}
            - name: digit-helmfile-plugin
              configMap:
                name: argocd-cmp-cm
          extraContainers:
            - name: digit-helmfile
              image: ghcr.io/helmfile/helmfile:v1.8.4
              command: [/var/run/argocd/argocd-cmp-server]
              securityContext:
                runAsNonRoot: true
                runAsUser: 999
                allowPrivilegeEscalation: false
                capabilities: {drop: [ALL]}
              env:
                - name: ARGOCD_EXEC_TIMEOUT
                  value: 10m
                # sops -> Azure Key Vault with the kubelet managed identity (IMDS)
                - name: AZURE_CLIENT_ID
                  value: {{ requiredEnv "KUBELET_CLIENT_ID" | quote }}
              resources:
                requests: {cpu: 200m, memory: 512Mi}
                limits: {memory: 2Gi}
              volumeMounts:
                - {name: var-files, mountPath: /var/run/argocd}
                - {name: plugins, mountPath: /home/argocd/cmp-server/plugins}
                - {name: digit-helmfile-plugin, mountPath: /home/argocd/cmp-server/config/plugin.yaml, subPath: digit-helmfile.yaml}
                - {name: cmp-tmp, mountPath: /tmp}
      # the argo-cd block of the environment file (overrides anything above)
      - {{ include "release-values" (dict "v" $v "r" "argo-cd" "ns" "argocd") | nindent 8 }}
