# Layer 1 - cluster-configs + backbone (helm.digit.org/digit3/{cluster-configs,backbone}).
# cluster-configs goes first: it creates the namespaces and the shared ConfigMaps/Secrets.
bases:
  - _environment.yaml.gotmpl
---
{{- /* Values of one release = its block in the env file (+ secrets file), without the keys
       only the helmfile uses. DIGIT common-based charts also get "global" and their namespace. */ -}}
{{- define "release-values" -}}
{{- $b := omit (.v | get .r dict) "chart-version" "enabled" -}}
{{- if hasKey . "common" }}{{ $b = merge (dict "global" (merge (dict "namespace" .ns) (.v | get "global" dict)) "namespace" .ns) $b }}{{ end -}}
{{- if hasKey . "wrap" }}{{ $b = dict .r $b }}{{ end -}}
{{- toYaml $b -}}
{{- end -}}
{{- define "chart-version" -}}
{{- required (printf "%s.chart-version is missing in the environment file" .r) (.v | get (printf "%s.chart-version" .r) "") -}}
{{- end -}}
{{- $v := .Values }}
repositories:
  - name: digit3-backbone
    url: https://helm.digit.org/digit3/backbone
  - name: digit3-cluster-configs
    url: https://helm.digit.org/digit3/cluster-configs
releases:
  - name: cluster-configs
    namespace: egov
    chart: digit3-cluster-configs/cluster-configs
    version: {{ include "chart-version" (dict "v" $v "r" "cluster-configs") }}
    labels: {layer: backbone, wave: "0"}
    values:
      - {{ include "release-values" (dict "v" $v "r" "cluster-configs" "ns" "egov" "wrap" true) | nindent 8 }}
{{- range $r := list
      (dict "name" "cert-manager"         "wave" "1" "needs" "egov/cluster-configs")
      (dict "name" "ingress-nginx"        "wave" "2" "needs" "backbone/cert-manager")
      (dict "name" "redis"                "wave" "1" "needs" "egov/cluster-configs" "common" true)
      (dict "name" "kafka-kraft"          "wave" "1" "needs" "egov/cluster-configs")
      (dict "name" "minio"                "wave" "1" "needs" "egov/cluster-configs" "common" true)
      (dict "name" "elasticsearch-master" "wave" "1" "needs" "egov/cluster-configs")
      (dict "name" "elasticsearch-data"   "wave" "2" "needs" "backbone/elasticsearch-master")
      (dict "name" "kibana"               "wave" "3" "needs" "backbone/elasticsearch-data" "common" true) }}
  - name: {{ $r.name }}
    namespace: backbone
    chart: digit3-backbone/{{ $r.name }}
    version: {{ include "chart-version" (dict "v" $v "r" $r.name) }}
    installed: {{ $v | get (printf "%s.enabled" $r.name) true }}
    labels: {layer: backbone, wave: "{{ $r.wave }}"}
    needs: [{{ $r.needs }}]
    values:
      - {{ include "release-values" (merge (dict "v" $v "r" $r.name "ns" "backbone") (pick $r "common")) | nindent 8 }}
{{- end }}
  # Vault starts sealed and empty: the postsync hook initialises/unseals it and writes the
  # AppRole the core services (otp, individual) log in with. Idempotent.
  - name: vault
    namespace: vault
    chart: digit3-backbone/vault
    version: {{ include "chart-version" (dict "v" $v "r" "vault") }}
    installed: {{ $v | get "vault.enabled" true }}
    labels: {layer: backbone, wave: "1"}
    needs: [egov/cluster-configs]
    wait: false
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: bash
        args: [../scripts/vault-bootstrap.sh, vault, egov]
    values:
      - {{ include "release-values" (dict "v" $v "r" "vault" "ns" "vault") | nindent 8 }}
