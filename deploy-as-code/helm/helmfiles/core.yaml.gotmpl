# Layer 2 - DIGIT core 3.0 (helm.digit.org/digit3/core): Keycloak, Kong, then every DIGIT
# service. A service = any block in the environment file with a chart-version that is not a
# platform release below; to add one, add its block (name = chart name in digit3/core).
bases:
  - _environment.yaml.gotmpl
---
{{- /* Values of one release = its block in the env file (+ secrets file), without the keys
       only the helmfile uses. DIGIT common-based charts also get "global" and their namespace. */ -}}
{{- define "release-values" -}}
{{- $b := omit (.v | get .r dict) "chart-version" "enabled" -}}
{{- if hasKey . "common" }}{{ $b = merge (dict "global" (merge (dict "namespace" .ns) (.v | get "global" dict)) "namespace" .ns) $b }}{{ end -}}
{{- if hasKey . "wrap" }}{{ $b = dict .r $b }}{{ end -}}
{{- toYaml $b -}}
{{- end -}}
{{- define "chart-version" -}}
{{- required (printf "%s.chart-version is missing in the environment file" .r) (.v | get (printf "%s.chart-version" .r) "") -}}
{{- end -}}
{{- $v := .Values }}
{{- $platform := list "infra" "global" "argo-cd" "keycloak" "kong" "cluster-configs" "cert-manager" "ingress-nginx" "redis" "kafka-kraft" "minio" "vault" "elasticsearch-master" "elasticsearch-data" "kibana" "kube-prometheus-stack" "loki" "grafana" "open-telemetry" "jaeger" "blackbox" "argocd" }}
repositories:
  - name: digit3-core
    url: https://helm.digit.org/digit3/core
releases:
  - name: keycloak
    namespace: egov
    chart: digit3-core/keycloak
    version: {{ include "chart-version" (dict "v" $v "r" "keycloak") }}
    installed: {{ $v | get "keycloak.enabled" true }}
    labels: {layer: core, wave: "4"}
    values:
      - {{ include "release-values" (dict "v" $v "r" "keycloak" "ns" "egov" "common" true) | nindent 8 }}

  - name: kong
    namespace: egov
    chart: digit3-core/kong
    version: {{ include "chart-version" (dict "v" $v "r" "kong") }}
    installed: {{ $v | get "kong.enabled" true }}
    labels: {layer: core, wave: "5"}
    needs: [egov/keycloak]
    values:
      - {{ include "release-values" (dict "v" $v "r" "kong" "ns" "egov") | nindent 8 }}
{{- range $svc := keys $v | sortAlpha }}
{{- if and (not (has $svc $platform)) (kindIs "map" (index $v $svc)) (hasKey (index $v $svc) "chart-version") }}

  - name: {{ $svc }}
    namespace: egov
    chart: digit3-core/{{ $svc }}
    version: {{ include "chart-version" (dict "v" $v "r" $svc) | quote }}
    installed: {{ $v | get (printf "%s.enabled" $svc) true }}
    labels: {layer: core, wave: "6"}
    needs: [egov/kong]
    values:
      - {{ include "release-values" (dict "v" $v "r" $svc "ns" "egov" "common" true) | nindent 8 }}
{{- end }}
{{- end }}
