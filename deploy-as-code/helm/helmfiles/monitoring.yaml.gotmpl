# Layer 3 - monitoring: community charts as published by their communities, plus the DIGIT
# blackbox exporter (helm.digit.org/digit3/backbone). Jaeger stores traces in Elasticsearch.
bases:
  - _environment.yaml.gotmpl
---
{{- /* Values of one release = its block in the env file (+ secrets file), without the keys
       only the helmfile uses. DIGIT common-based charts also get "global" and their namespace. */ -}}
{{- define "release-values" -}}
{{- $b := omit (.v | get .r dict) "chart-version" "enabled" -}}
{{- if hasKey . "common" }}{{ $b = merge (dict "global" (merge (dict "namespace" .ns) (.v | get "global" dict)) "namespace" .ns) $b }}{{ end -}}
{{- if hasKey . "wrap" }}{{ $b = dict .r $b }}{{ end -}}
{{- toYaml $b -}}
{{- end -}}
{{- define "chart-version" -}}
{{- required (printf "%s.chart-version is missing in the environment file" .r) (.v | get (printf "%s.chart-version" .r) "") -}}
{{- end -}}
{{- $v := .Values }}
repositories:
  - name: digit3-backbone
    url: https://helm.digit.org/digit3/backbone
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: jaegertracing
    url: https://jaegertracing.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
releases:
{{- range $r := list
      (dict "name" "kube-prometheus-stack" "chart" "prometheus-community/kube-prometheus-stack" "wave" "7")
      (dict "name" "loki"                  "chart" "grafana/loki"                              "wave" "7")
      (dict "name" "grafana"               "chart" "grafana/grafana"                           "wave" "8" "needs" "monitoring/kube-prometheus-stack")
      (dict "name" "open-telemetry"        "chart" "open-telemetry/opentelemetry-collector"    "wave" "7")
      (dict "name" "jaeger"                "chart" "jaegertracing/jaeger"                      "wave" "7")
      (dict "name" "blackbox"              "chart" "digit3-backbone/prometheus-blackbox-exporter" "wave" "7") }}
  - name: {{ $r.name }}
    namespace: monitoring
    chart: {{ $r.chart }}
    version: {{ include "chart-version" (dict "v" $v "r" $r.name) }}
    installed: {{ $v | get (printf "%s.enabled" $r.name) true }}
    labels: {layer: monitoring, wave: "{{ $r.wave }}"}
    {{- if hasKey $r "needs" }}
    needs: [{{ $r.needs }}]
    {{- end }}
    {{- if eq $r.name "kube-prometheus-stack" }}
    disableValidation: true
    {{- end }}
    values:
      - {{ include "release-values" (dict "v" $v "r" $r.name "ns" "monitoring") | nindent 8 }}
    {{- if eq $r.name "jaeger" }}
      # The jaeger chart writes ES_PASSWORD into its index-cleaner CronJob only from this
      # value: take it from the one entry in the secrets file.
      - storage:
          elasticsearch:
            password: {{ $v | get "cluster-configs.secrets.elasticsearch-master-credentials.password" "" | quote }}
    {{- end }}
{{- end }}
