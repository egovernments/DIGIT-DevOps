# chart default pins "backbone"
namespaceOverride: {{ .Release.Namespace }}
controller:
  service:
    annotations:
      # AKS load balancer probes "/" on the HTTP port by default, which ingress-nginx answers
      # with 404 -> backends marked unhealthy. Probe the controller health endpoint instead.
      service.beta.kubernetes.io/azure-load-balancer-health-probe-request-path: /healthz
