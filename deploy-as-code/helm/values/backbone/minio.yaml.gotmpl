{{- $s := .Values.secrets.minio }}
namespace: {{ .Release.Namespace }}
mode: standalone
replicas: 1
# Root credentials from the team's secrets (the chart creates its own Secret).
existingSecret: ""
rootUser: {{ $s.username | quote }}
rootPassword: {{ $s.password | quote }}
persistence:
  storageClass: ""          # chart default is AWS gp2; "" = the cluster's default class
  size: {{ .Values.sizing.minio.diskSize }}
buckets:
  - name: {{ .Values.filestore.bucket }}
    policy: none
    purge: false
consoleIngress:
  enabled: false            # don't publish the MinIO console with root credentials
