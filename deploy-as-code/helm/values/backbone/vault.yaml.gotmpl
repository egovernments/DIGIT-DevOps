global:
  namespace: {{ .Release.Namespace }}
server:
  dataStorage:
    size: {{ .Values.sizing.vault.diskSize }}
  # Vault seals itself on every restart. scripts/vault-bootstrap.sh keeps the unseal key in
  # Secret vault-unseal; mount it (optional: absent before first init) and unseal on start.
  volumes:
    - name: vault-unseal
      secret:
        secretName: vault-unseal
        optional: true
  volumeMounts:
    - name: vault-unseal
      mountPath: /vault/unseal
      readOnly: true
  postStart:
    - /bin/sh
    - -c
    - >-
      [ -f /vault/unseal/unseal-key ] || exit 0;
      for i in $(seq 1 60); do
      vault status >/dev/null 2>&1; rc=$?;
      [ "$rc" = 0 ] && exit 0;
      [ "$rc" = 2 ] && vault operator unseal "$(cat /vault/unseal/unseal-key)" >/dev/null 2>&1 && exit 0;
      sleep 2; done; exit 0
