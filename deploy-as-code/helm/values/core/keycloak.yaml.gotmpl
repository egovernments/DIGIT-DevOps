ingress:
  additionalAnnotations: |
    cert-manager.io/cluster-issuer: {{ .Values.tls.issuer }}
# db-init creates Keycloak's database and kc-db role. Azure PostgreSQL has no "postgres"
# superuser: use the server admin (secrets.db), which holds CREATEDB + CREATEROLE.
dbInit:
  adminUser: {{ .Values.secrets.db.username | quote }}
  adminSecret:
    name: db
    key: password
