# global block for DIGIT charts built on digit3/common (and others reading global.*).
# namespace = the release's own namespace, so objects always land where helmfile installs.
# charts that read a root namespace value (instead of global.namespace)
namespace: {{ .Release.Namespace }}
global:
  domain: {{ .Values.domain }}
  namespace: {{ .Release.Namespace }}
  mode: {{ .Values.imageMode }}
  containerRegistry: {{ .Values.containerRegistry }}
  setup: fullsetup
