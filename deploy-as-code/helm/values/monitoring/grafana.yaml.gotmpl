# Local admin login (password from secrets.yaml) instead of the shared GitHub OAuth app.
adminUser: admin
adminPassword: {{ .Values.secrets.grafana.adminPassword | quote }}
grafana.ini:
  auth.github:
    enabled: false
persistence:
  size: {{ .Values.sizing.monitoring.grafanaDiskSize }}
ingress:
  enabled: true
  annotations:
    cert-manager.io/cluster-issuer: {{ .Values.tls.issuer }}
    kubernetes.io/ingress.class: nginx
  hosts:
    - {{ .Values.domain }}
  tls:
    - hosts: [{{ .Values.domain }}]
      secretName: {{ .Values.domain }}-tls-certs
