{{- $es := printf "http://elasticsearch-master.%s:9200" .Values.namespaces.backbone }}
{{- $pw := .Values.secrets.elasticsearch.password }}
# Trace storage = the backbone Elasticsearch, with this environment's credentials.
userconfig:
  extensions:
    jaeger_storage:
      backends:
        primary_store_elasticsearch:
          elasticsearch:
            server_urls: [{{ $es | quote }}]
            auth:
              basic:
                username: elastic
                password: {{ $pw | quote }}
        archive_store_elasticsearch:
          elasticsearch:
            server_urls: [{{ $es | quote }}]
            auth:
              basic:
                username: elastic
                password: {{ $pw | quote }}
storage:
  elasticsearch:
    url: {{ $es | quote }}
    user: elastic
    password: {{ $pw | quote }}
