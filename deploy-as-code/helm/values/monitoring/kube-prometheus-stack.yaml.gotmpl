{{- $mon := .Values.namespaces.monitoring }}
# AKS manages the control plane: scheduler, controller-manager and etcd are not reachable,
# and AKS kube-proxy pods do not carry the k8s-app=kube-proxy label. Scraping them only
# yields permanent "target down" alerts.
kubeControllerManager: {enabled: false}
kubeScheduler: {enabled: false}
kubeEtcd: {enabled: false}
kubeProxy: {enabled: false}
prometheus:
  prometheusSpec:
    retention: {{ .Values.sizing.monitoring.prometheusRetention }}
    externalLabels:
      cluster: {{ .Values.infra.clusterName | default .Values.domain | quote }}
    # Probe the public DIGIT endpoints through the blackbox exporter.
    additionalScrapeConfigs:
      - job_name: blackbox
        metrics_path: /probe
        params:
          module: [http_2xx]
        static_configs:
          - targets:
              - https://{{ .Values.domain }}/keycloak/realms/master
{{- if .Values.components.elasticsearch }}
              - https://{{ .Values.domain }}/kibana/api/status
{{- end }}
        relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: prometheus-blackbox-exporter.{{ $mon }}:9115
